# Copy to .env (setup.sh does this). NEVER commit .env: it holds secrets.

# ── Required ────────────────────────────────────────────────────────────────
# Google Gemini API key (https://aistudio.google.com/apikey). Several keys may be comma-separated to
# spread rate limits.
GEMINI_API_KEY=

# Full path to your resume PDF. `apply --no-pack` uploads it, and it is the fallback when a pack has no CV.
MASTER_RESUME_PATH=/full/path/to/your_resume.pdf

# ── Safety (leave at 0 unless you really want unattended submission) ───────────────────────────
# 0 = the browser agent stops at the review step, 1 = it submits without stopping.
JOB_FINDER_DISABLE_GUARDRAILS=0

# ── Browser agent ─────────────────────────────────────────────────────────────────────────────
BROWSER_USE_HEADLESS=false
SCRAPER_CONCURRENCY=5
PORT=8000

# ── Optional: job-portal sign-ups ─────────────────────────────────────────────────────────────
# Password the agent uses if an application form forces it to create an account on a job portal.
# Use a unique throwaway password, never one you use anywhere else.
PORTALS_PASSWORD=

# ── Optional: email alerts when applications are submitted or need attention ──────────────────
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
NOTIFY_EMAIL=

# ── Optional: overrides ───────────────────────────────────────────────────────────────────────
# JOB_FINDER_TRACKER_XLSX=/path/to/scanned_jobs.xlsx
# JOB_FINDER_APPROVED_XLSX=/path/to/approved_jobs.xlsx
# JOB_FINDER_APPLICATIONS_DIR=/path/to/applications
# JOB_FINDER_VENV=/path/to/venv

# ── Optional: more job sources (official APIs, free keys) ─────────────────────────────────────
# Adzuna aggregates many UK job boards: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Reed: https://www.reed.co.uk/developers
REED_API_KEY=
