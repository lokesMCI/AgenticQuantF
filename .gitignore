# ─────────────────────────────────────────────────────────────────────────────
# WHITELIST: everything in the project root is ignored unless it is listed below.
# The working folder also holds PRIVATE data (.env, candidate_profile.json, Excel
# trackers, application packs with your CV, caches, virtualenvs). None of it is ever
# committed. To publish a new file, add an explicit "!/name" line here.
# ─────────────────────────────────────────────────────────────────────────────
/*
!/.gitignore
!/README.md
!/LICENSE
!/jf
!/setup.sh
!/.env.example
!/candidate_profile.example.json
!/job-finder-src/

# inside job-finder-src (the application code)
job-finder-src/_download/
job-finder-src/**/__pycache__/
job-finder-src/**/*.pyc
job-finder-src/*.egg-info/
job-finder-src/.pytest_cache/
job-finder-src/**/.env
job-finder-src/**/candidate_profile.json
job-finder-src/**/*.db
job-finder-src/**/*.xlsx
job-finder-src/data/
job-finder-src/**/topic_terms.json
job-finder-src/**/board_index.db

# ─────────────────────────────────────────────────────────────────────────────
# (original repository ignore rules, kept)
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
.env
.env.*
!.env.example
.DS_Store
